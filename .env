# LINE Login（生产必填；本地开发可留空并开启下方 AUTH_DEV_MODE）
LINE_CHANNEL_ID=

# 开发兜底登录：仅未配置 LINE 渠道时生效；生产必须置 false
AUTH_DEV_MODE=true

# 生产必须开启（HTTPS 下）
SESSION_COOKIE_SECURE=false

# 对象存储后端：local=本地盘（默认，测试用）；firebase=Firebase Storage（生产/本地联调）
# 走 firebase 需本机已配置 GCP 凭证（gcloud auth application-default login）
STORAGE_BACKEND=firebase
GOOGLE_CLOUD_PROJECT=saiflow-509205
FIREBASE_STORAGE_BUCKET=saiflow-509205.firebasestorage.app

